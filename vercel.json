{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "index:app",
      "functions": {
        "index.py": {
          "maxDuration": 300,
          "includeFiles": "{data/index,data/samples,eval/results}/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "api"
      }
    }
  ]
}
