{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "index:app",
      "functions": { "index.py": { "maxDuration": 300 } }
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "api" } }]
}
